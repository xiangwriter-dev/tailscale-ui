{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xiangwriter远程器",
  "version": "0.2.0",
  "identifier": "com.xiangwriter.remote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "xiangwriter远程器", "width": 1380, "height": 860, "minWidth": 1024, "minHeight": 720 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "shortDescription": "Tailscale 设备管理与配对远程任务",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true, "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
